// matrix hook @ 0x4D3782: 1..8/191..198 stock, 14..18 mono q7, else q10 CMCM @ q7 CCMatrix

.include "m5_addrs.inc"

    ld      @(r14, #12), r0
    cmp     #9, r0
    blt     stock
    ldi:8   #190, r1
    cmp     r1, r0
    bgt     stock

    st      r6, @-r15
    st      r7, @-r15
    st      r8, @-r15
    st      r9, @-r15
    st      r10, @-r15
    st      r11, @-r15
    st      RP, @-r15

    cmp     #14, r0
    blt     do_leftmul
    ldi:8   #18, r1
    cmp     r1, r0
    bgt     do_leftmul

    add2    #-14, r0
    ldi:8   #20, r1
    mul     r1, r0
    mov     MDL, r0
    ldi:32  #VA_MONO_TABLE, r4
    add     r0, r4
    ldi:32  #SYM_COMMIT_CCMAT, r12
    call    @r12
    bra     epilogue

do_leftmul:
    add2    #-9, r0
    lsl     #5, r0
    ldi:32  #VA_CMCM_TABLE, r8
    add     r0, r8
    ldi:32  #SYM_CC_MATRIX_Q7, r9

    addsp   #-24
    mov     r15, r10
    ldi:20  #0x00200, r0
    sth     r0, @r10

    ldi:8   #0, r6
loop_i:
    ldi:8   #0, r7
loop_j:
    ldi:8   #0, r11
    ldi:8   #0, r5

loop_k:
    mov     r5, r13
    lsl     #1, r13
    add     r6, r13
    lduh    @(r13, r8), r2
    extsh   r2

    mov     r5, r13
    lsl     #2, r13
    mov     r5, r0
    lsl     #1, r0
    add     r0, r13
    add     r7, r13
    lduh    @(r13, r9), r3
    ldi:20  #0x00800, r0
    and     r3, r0
    beq     cc_pos
    ldi:32  #0xFFFFF000, r0
    or      r0, r3
cc_pos:
    mul     r2, r3
    mov     MDL, r0
    add     r0, r11

    add     #1, r5
    cmp     #3, r5
    blt     loop_k

    ldi:20  #0x00200, r0
    add     r0, r11
    asr     #10, r11

    ldi:20  #0x007FF, r0
    cmp     r0, r11
    ble     hi_ok
    mov     r0, r11
hi_ok:
    ldi:32  #0xFFFFF801, r0
    cmp     r0, r11
    bge     lo_ok
    mov     r0, r11
lo_ok:
    ldi:20  #0x00FFF, r0
    and     r0, r11
    mov     r6, r13
    add     r7, r13
    add     #2, r13
    sth     r11, @(r13, r10)

    add     #2, r7
    cmp     #6, r7
    blt     loop_j

    add     #6, r6
    ldi:8   #18, r0
    cmp     r0, r6
    blt     loop_i

    mov     r10, r4
    ldi:32  #SYM_COMMIT_CCMAT, r12
    call    @r12
    addsp   #24

epilogue:
    ld      @r15+, RP
    ld      @r15+, r11
    ld      @r15+, r10
    ld      @r15+, r9
    ld      @r15+, r8
    ld      @r15+, r7
    ld      @r15+, r6
    ret

stock:
    ldi:32  #SYM_STOCK_MATRIX, r12
    jmp     @r12
