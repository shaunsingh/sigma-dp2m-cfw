// spatial driver @ 0x4D738E (pre-hw-jpeg); scratch 0x80100000..0x8010C800

.include "m5_addrs.inc"

.macro st_ctx off, src
    st      \src, @(r14, #-144 + \off)
.endm

.macro ld_ctx off, dst
    ld      @(r14, #-144 + \off), \dst
.endm

    st      r4, @-r15
    st      r5, @-r15
    st      r6, @-r15
    st      r7, @-r15
    st      RP, @-r15

    // stock SYM_GET_JOB_CM (0x4DD702) only clobbers r0, r1, r4, r12, r13, so r2 survives across it
    ld      @(r14, #8), r4 ; extsh r4
    ldi:32  #SYM_GET_JOB_1D, r12 ; call @r12 ; mov r4, r2
    ld      @(r14, #8), r4 ; extsh r4
    ldi:32  #SYM_GET_JOB_CM, r12 ; call @r12 ; mov r4, r3

    // bypass when fx==0, fill==0, mode<151
    mov     r2, r0 ; lsr #2, r0 ; ldi:8 #0x1F, r1 ; and r1, r0
    bne     do_work
    ldi:8   #151, r1 ; cmp r1, r3 ; bge do_work

fast_stock:
    ld      @r15+, RP
    ld      @r15+, r7
    ld      @r15+, r6
    ld      @r15+, r5
    ld      @r15+, r4
    ldi:32  #SYM_HW_JPEG_ENCODE, r12
    jmp     @r12

do_work:
    ld      @(r15, #20), r0
    ld      @(r15, #8), r4
    st      r8, @-r15
    st      r9, @-r15
    st      r10, @-r15
    st      r11, @-r15
    enter   #160
    st      r3, @(r14, #-8)
    st      r0, @(r14, #-12)
    st      r4, @(r14, #-16)

    // packed_1d: cs=[1:0], fx=[4:2] (b0 3d lut, b1 grain, b2 halation), fill=[6:5]
    mov     r2, r0 ; ldi:8 #3, r5 ; and r5, r0 ; st r0, @(r14, #-20)
    mov     r2, r0 ; lsr #2, r0 ; ldi:8 #7, r5 ; and r5, r0 ; st r0, @(r14, #-24)
    mov     r2, r0 ; lsr #5, r0 ; ldi:8 #3, r5 ; and r5, r0 ; st r0, @(r14, #-28)

    ldi:8   #0, r0
    st_ctx  36, r0 ; st_ctx 40, r0 ; st_ctx 60, r0 ; st_ctx 64, r0
    st_ctx  68, r0 ; st_ctx 72, r0 ; st_ctx 76, r0 ; st_ctx 80, r0 ; st_ctx 84, r0

    ld      @(r14, #-24), r0 ; st_ctx 28, r0
    ld      @(r14, #-28), r0 ; st_ctx 32, r0
    ldi:32  #VA_GRAIN_ENVS, r0 ; st_ctx 44, r0
    ldi:8   #28, r0 ; st_ctx 48, r0
    ldi:8   #1, r0  ; st_ctx 52, r0
    ldi:8   #64, r0 ; st_ctx 56, r0

    ld      @(r14, #-8), r4
    cmp     #9, r4 ; blt.far meta_done
    ldi:8   #MAX_PACKED_MODE, r0 ; cmp r0, r4 ; bgt.far meta_done

    mov     r4, r0 ; add2 #-9, r0 ; lsl #2, r0
    ldi:32  #VA_MODE_META, r1 ; add r0, r1
    ldub    @r1, r2 ; st_ctx 48, r2
    ldi:8   #1, r13 ; ldub @(r13, r1), r2
    ldi:8   #1, r3 ; cmp #2, r2 ; bne cd_ok ; ldi:8 #0, r3
cd_ok:
    st_ctx  52, r3
    lsl     #8, r2 ; ldi:32 #VA_GRAIN_ENVS, r3 ; add r3, r2 ; st_ctx 44, r2
    ldi:8   #2, r13 ; ldub @(r13, r1), r2 ; st_ctx 56, r2
    ldi:8   #3, r13 ; ldub @(r13, r1), r2 ; st_ctx 60, r2

    ldi:8   #19, r0  ; cmp r0, r4 ; blt.far meta_done
    ldi:8   #150, r0 ; cmp r0, r4 ; bgt chk_bw

    ld      @(r14, #-24), r0 ; ldi:8 #1, r1 ; and r1, r0 ; beq.far meta_done
    mov     r4, r0 ; ldi:8 #19, r1 ; sub r1, r0
    ldi:20  #LUT3D_STRIDE, r1 ; mul r1, r0 ; mov MDL, r0
    ld      @(r14, #-20), r2 ; cmp #2, r2 ; beq l3_argb
    ldi:32  #VA_LUT3D_SRGB, r1 ; bra l3_set
l3_argb:
    ldi:32  #VA_LUT3D_ARGB, r1
l3_set:
    add     r1, r0 ; st_ctx 36, r0
    jmp.far meta_done

chk_bw:
    ldi:8   #190, r0 ; cmp r0, r4 ; bgt load_sd_lut
    mov     r4, r0 ; ldi:8 #151, r1 ; sub r1, r0
    lsl     #9, r0 ; ldi:32 #VA_BW_TONER_40, r1 ; add r1, r0
    st_ctx  40, r0
    jmp.far meta_done

// 191..198 -> D:\LUT1.BIN..D:\LUT8.BIN (grain/halation meta even w/o the 3d lut)
load_sd_lut:
    ld      @(r14, #-24), r0 ; cmp #0, r0 ; beq.far meta_done
    ldi:32  #VA_SD_PATH_TMPL, r8
    ldi:32  #SCRATCH_SD_PATH, r9
    ld      @r8, r0 ; st r0, @r9
    ldi:8   #4, r13 ; ld @(r13, r8), r0 ; st r0, @(r13, r9)
    ldi:8   #8, r13 ; ld @(r13, r8), r0 ; st r0, @(r13, r9)
    ld      @(r14, #-8), r0 ; ldi:8 #191, r1 ; sub r1, r0
    ldi:8   #'1', r1 ; add r1, r0
    ldi:8   #6, r13 ; stb r0, @(r13, r9)
    mov     r9, r4 ; ldi:8 #0, r5 ; ldi:8 #0, r6
    ldi:32  #SYM_MDF_OPEN, r12 ; call @r12
    cmp     #0, r4 ; blt meta_done
    mov     r4, r8
    ldi:32  #SCRATCH_SD_LUT, r5
    ldi:20  #0x1040, r6
    ldi:32  #SCRATCH_SD_NREAD, r7
    ldi:32  #SYM_MDF_READ, r12 ; call @r12
    mov     r4, r9
    mov     r8, r4 ; ldi:32 #SYM_MDF_CLOSE, r12 ; call @r12
    cmp     #0, r9 ; bne meta_done
    ldi:32  #SCRATCH_SD_NREAD, r0 ; ld @r0, r0 ; ldi:20 #0x1040, r1 ; cmp r1, r0 ; bne meta_done
    ldi:32  #SCRATCH_SD_LUT, r8
    ld      @r8, r0 ; ldi:32 #0x44324D4C, r1 ; cmp r1, r0 ; bne meta_done
    ldi:8   #6, r13 ; ldub @(r13, r8), r0
    cmp     #2, r0 ; bhi meta_done
    ldi:8   #1, r1 ; cmp #2, r0 ; bne sd_cd ; ldi:8 #0, r1
sd_cd:
    st_ctx  52, r1
    lsl     #8, r0 ; ldi:32 #VA_GRAIN_ENVS, r1 ; add r1, r0 ; st_ctx 44, r0
    // clamp grain_amp <= 64 so ftg_enter (1024 - 15*scale) stays >= 0 and VA_CLAMP_CENTER stays in bounds
    ldi:8   #5, r13 ; ldub @(r13, r8), r0
    ldi:8   #64, r1 ; cmp r1, r0 ; bls sd_ga_ok ; mov r1, r0
sd_ga_ok:
    st_ctx  48, r0
    ldi:8   #7, r13 ; ldub @(r13, r8), r0 ; st_ctx 56, r0
    ldi:8   #8, r13 ; ldub @(r13, r8), r0 ; st_ctx 60, r0
    ld      @(r14, #-24), r0 ; ldi:8 #1, r1 ; and r1, r0 ; beq meta_done
    ldi:8   #0x10, r0 ; add r8, r0 ; st_ctx 36, r0
    ldi:32  #0x80808080, r1
    ldi:20  #0x1030, r13
sd_bias:
    add2    #-4, r13
    ld      @(r13, r0), r2 ; eor r1, r2 ; st r2, @(r13, r0)
    cmp     #0, r13 ; bgt sd_bias

meta_done:
    // work = lut | toner | fill | grain | (halation & gain)
    ld_ctx  36, r0 ; ld_ctx 40, r1 ; or r1, r0
    ld_ctx  32, r1 ; or r1, r0
    ld      @(r14, #-24), r1 ; ldi:8 #2, r2 ; and r1, r2 ; or r2, r0
    ldi:8   #0, r3
    ldi:8   #4, r2 ; and r2, r1 ; beq no_halo_work
    ld_ctx  56, r3 ; or r3, r0
no_halo_work:
    st      r3, @(r14, #-32)
    cmp     #0, r0 ; bne has_work
done_exit:
    leave
    ld      @r15+, r11
    ld      @r15+, r10
    ld      @r15+, r9
    ld      @r15+, r8
    jmp.far fast_stock

has_work:
    ldi:8   #0, r4 ; ld @(r14, #-16), r5 ; ldi:32 #SYM_GET_IMG_DIM, r12 ; call @r12 ; st_ctx 12, r4
    ldi:8   #1, r4 ; ld @(r14, #-16), r5 ; ldi:32 #SYM_GET_IMG_DIM, r12 ; call @r12 ; st_ctx 16, r4

    ld      @(r14, #-16), r0
    cmp     #5, r0 ; beq str_5
    cmp     #4, r0 ; beq str_4
    cmp     #3, r0 ; beq str_3
    ldi:32  #SYM_STRIDE_DEFAULT, r12 ; call @r12
    ld      @(r14, #-12), r0 ; cmp #0, r0 ; beq str_done
    ldi:8   #0x20, r0 ; add r0, r4 ; bra str_done
str_5:
    ldi:32  #SYM_STRIDE_5, r12 ; call @r12 ; bra str_done
str_4:
    ldi:32  #SYM_STRIDE_4, r12 ; call @r12 ; bra str_done
str_3:
    ldi:32  #SYM_STRIDE_3, r12 ; call @r12
str_done:
    st_ctx  20, r4 ; lsr #1, r4 ; st_ctx 24, r4

    ld      @(r14, #36), r8
    ld      @r8, r0
    ldi:8   #4, r13 ; ld @(r13, r8), r1
    ldi:8   #8, r13 ; ld @(r13, r8), r2
    ld      @(r14, #-12), r3 ; cmp #0, r3 ; beq ptrs_ok
    ld      @(r14, #-16), r3 ; cmp #1, r3 ; bne ptrs_ok
    ldi:20  #0x0E700, r3 ; add r3, r0
    lsr     #1, r3 ; add r3, r1 ; add r3, r2
ptrs_ok:
    st_ctx  0, r0 ; st_ctx 4, r1 ; st_ctx 8, r2

    ld_ctx  12, r0 ; ldi:8 #32, r1 ; cmp r1, r0 ; blt.far done_exit
    ld_ctx  16, r0 ; cmp r1, r0 ; blt.far done_exit

    ld      @(r14, #-32), r0 ; ld @(r14, #-28), r1 ; or r1, r0
    cmp     #0, r0 ; beq.far run_passes

    ld_ctx  12, r0 ; ldi:20 #1024, r1 ; cmp r1, r0 ; blt pyr_small
    ld_ctx  16, r0 ; ldi:20 #512, r1  ; cmp r1, r0 ; blt pyr_small
    ldi:8   #80, r0 ; st r0, @(r14, #-40) ; st_ctx 64, r0
    ldi:8   #53, r0 ; st r0, @(r14, #-44) ; st_ctx 68, r0
    ldi:8   #6, r0  ; st_ctx 72, r0
    ld_ctx  12, r0 ; ldi:8 #80, r1 ; ldi:8 #0, r3
div_pdx:
    cmp     r1, r0 ; blt div_pdx_d ; sub r1, r0 ; add #1, r3 ; bra div_pdx
div_pdx_d:
    ld_ctx  16, r0 ; ldi:8 #53, r1 ; ldi:8 #0, r2
div_pdy:
    cmp     r1, r0 ; blt div_pdy_d ; sub r1, r0 ; add #1, r2 ; bra div_pdy
div_pdy_d:
    ld_ctx  0, r9
    ld_ctx  20, r0
    mul     r2, r0 ; mov MDL, r10
    lsr     #1, r2
    mul     r2, r0 ; mov MDL, r11
    bra     pyr_dispatch

pyr_small:
    ldi:8   #63, r1
    ld_ctx  12, r0 ; lsr #4, r0 ; cmp r1, r0 ; ble ps_w_ok ; mov r1, r0
ps_w_ok:
    st      r0, @(r14, #-40) ; st_ctx 64, r0
    ld_ctx  16, r0 ; lsr #4, r0 ; cmp r1, r0 ; ble ps_h_ok ; mov r1, r0
ps_h_ok:
    st      r0, @(r14, #-44) ; st_ctx 68, r0
    ldi:8   #4, r0 ; st_ctx 72, r0
    ld_ctx  0, r9
    ld_ctx  20, r10 ; lsl #4, r10
    ld_ctx  20, r11 ; lsl #3, r11
    ldi:8   #16, r3

pyr_dispatch:
    ld      @(r14, #-44), r6
    mov     r3, r12 ; lsr #1, r12 ; st r12, @(r14, #-48)
    ld      @(r14, #-32), r0 ; cmp #0, r0 ; beq pyr_fill_only

    // reuse SCRATCH_BLUR_LINE (256 B) as scaled halo optical LUT during pyramid build
    ldi:32  #VA_HALO_OPT_LUT, r5
    ldi:32  #SCRATCH_BLUR_LINE, r12
    ldi:20  #256, r13
ph_lut_lp:
    add2    #-1, r13
    ldub    @(r13, r5), r1 ; mul r0, r1 ; mov MDL, r1 ; lsr #8, r1
    stb     r1, @(r13, r12)
    cmp     #0, r13 ; bgt ph_lut_lp

    ld      @(r14, #-28), r0 ; cmp #0, r0 ; beq pyr_halo_only

    // both halation & fill: r12=scaled halo LUT, r6=pdx/2, r10=r11+pdx/2, r9=HALO_CORE-HALO_GRID
    st      r6, @(r14, #-148)
    st      r9, @(r14, #-152)
    st      r10, @(r14, #-156)
    ld      @(r14, #-48), r6
    mov     r11, r10 ; add r6, r10
    ldi:20  #SCRATCH_HALO_CORE - SCRATCH_HALO_GRID, r9
    ldi:32  #SCRATCH_HALO_GRID, r8
    ldi:8   #0, r4
pyr_by:
    ld      @(r14, #-40), r7
    ld      @(r14, #-152), r5
pyr_bx:
    ldub    @r5, r0 ; mov r0, r2
    mov     r6, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    cmp     r0, r1 ; ble pbm1 ; mov r1, r0
pbm1:
    mov     r10, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    cmp     r0, r1 ; ble pbm2 ; mov r1, r0
pbm2:
    mov     r11, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    cmp     r0, r1 ; ble pbm3 ; mov r1, r0
pbm3:
    lsr     #2, r2
    ldi:20  #SCRATCH_FILL_GRID - SCRATCH_HALO_GRID, r13 ; stb r2, @(r13, r8)
    add     r2, r4

    mov     r0, r13 ; ldub @(r13, r12), r0
    stb     r0, @r8
    mov     r9, r13 ; stb r0, @(r13, r8)

    add     #1, r8
    add     r3, r5
    add2    #-1, r7 ; cmp #0, r7 ; bgt pyr_bx
    ld      @(r14, #-152), r0 ; ld @(r14, #-156), r1 ; add r1, r0 ; st r0, @(r14, #-152)
    ld      @(r14, #-148), r0 ; add2 #-1, r0 ; st r0, @(r14, #-148) ; cmp #0, r0 ; bgt pyr_by
    jmp.far finish_ym

pyr_halo_only:
    // r12=scaled halo LUT, r2=pdx/2, r4=r11+pdx/2
    ldi:32  #SCRATCH_HALO_GRID, r8
    ld      @(r14, #-48), r2
    mov     r11, r4 ; add r2, r4
pyr_hy:
    ld      @(r14, #-40), r7
    mov     r9, r5
pyr_hx:
    ldub    @r5, r0
    mov     r2, r13 ; ldub @(r13, r5), r1 ; cmp r0, r1 ; ble phm1 ; mov r1, r0
phm1:
    mov     r4, r13 ; ldub @(r13, r5), r1 ; cmp r0, r1 ; ble phm2 ; mov r1, r0
phm2:
    mov     r11, r13 ; ldub @(r13, r5), r1 ; cmp r0, r1 ; ble phm3 ; mov r1, r0
phm3:
    mov     r0, r13 ; ldub @(r13, r12), r0
    stb     r0, @r8
    ldi:20  #SCRATCH_HALO_CORE - SCRATCH_HALO_GRID, r13 ; stb r0, @(r13, r8)
    add     #1, r8
    add     r3, r5
    add2    #-1, r7 ; cmp #0, r7 ; bgt pyr_hx
    add     r10, r9 ; add2 #-1, r6 ; cmp #0, r6 ; bgt pyr_hy
    bra     do_halo_blur

pyr_fill_only:
    ldi:32  #SCRATCH_FILL_GRID, r8
    ldi:8   #0, r4
pyr_fy:
    ld      @(r14, #-40), r7
    mov     r9, r5
pyr_fx:
    ldub    @r5, r2
    mov     r12, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    mov     r11, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    add     r12, r13 ; ldub @(r13, r5), r1 ; add r1, r2
    lsr     #2, r2
    stb     r2, @r8 ; add #1, r8
    add     r2, r4
    add     r3, r5
    add2    #-1, r7 ; cmp #0, r7 ; bgt pyr_fx
    add     r10, r9 ; add2 #-1, r6 ; cmp #0, r6 ; bgt pyr_fy

finish_ym:
    mov     r4, r0
    ld      @(r14, #-40), r1 ; ld @(r14, #-44), r2 ; mul r2, r1 ; mov MDL, r4
    lsl     #7, r4
    ldi:8   #0, r2
    ldi:8   #128, r5
div_ym:
    cmp     r4, r0 ; blt div_skip ; sub r4, r0 ; or r5, r2
div_skip:
    lsr     #1, r4 ; lsr #1, r5 ; cmp #0, r5 ; bgt div_ym
    ldi:8   #128, r0 ; add r0, r2 ; lsr #1, r2 ; st_ctx 84, r2

    ld      @(r14, #-32), r0 ; cmp #0, r0 ; beq chk_fill_blur

do_halo_blur:
    // two-scale halo psf: 1-pass core + 3-pass tail, 50/50 SWAR blend
    ldi:32  #SCRATCH_HALO_CORE, r0 ; ldi:8 #1, r11 ; call blur_5tap_sub
    ldi:32  #SCRATCH_HALO_GRID, r0 ; ldi:8 #3, r11 ; call blur_5tap_sub
    ld      @(r14, #-40), r0 ; ld @(r14, #-44), r1 ; mul r1, r0 ; mov MDL, r6
    ldi:32  #SCRATCH_HALO_GRID, r8 ; ldi:32 #SCRATCH_HALO_CORE, r9
    ldi:32  #0xFEFEFEFE, r3
    ldi:8   #4, r4
hblend_w:
    cmp     r4, r6 ; blt hblend_t
    ld      @r8, r0 ; ld @r9, r1
    mov     r0, r2 ; and r1, r2 ; eor r1, r0 ; and r3, r0 ; lsr #1, r0 ; add r2, r0
    st      r0, @r8
    add     #4, r8 ; add #4, r9 ; add2 #-4, r6
    bra     hblend_w
hblend_t:
    cmp     #0, r6 ; ble hblend_d
    ldub    @r8, r0 ; ldub @r9, r1 ; add r1, r0 ; lsr #1, r0 ; stb r0, @r8
    add     #1, r8 ; add #1, r9 ; add2 #-1, r6
    bra     hblend_t
hblend_d:
    ldi:32  #SCRATCH_HALO_GRID, r0 ; st_ctx 76, r0

chk_fill_blur:
    ld      @(r14, #-28), r0 ; cmp #0, r0 ; beq run_passes
    ldi:32  #SCRATCH_FILL_GRID, r0 ; ldi:8 #3, r11 ; call blur_5tap_sub
    ldi:32  #SCRATCH_FILL_GRID, r0 ; st_ctx 80, r0

run_passes:
    ld_ctx  36, r0 ; cmp #0, r0 ; beq rp_call
    ldi:32  #SCRATCH_SAK_MAGIC, r8
    ldi:32  #0x53414B31, r1
    ld      @r8, r2 ; cmp r1, r2 ; bne sak_cache_clear
    // SDRAM lut3d ptr (>= 0x80000000, signed < 0) is mutable SD LUT and always invalidates cache
    cmp     #0, r0 ; blt sak_cache_clear
    ldi:8   #4, r13 ; ld @(r13, r8), r2 ; cmp r0, r2 ; beq rp_call
sak_cache_clear:
    ldi:8   #0, r2
    ldi:32  #SCRATCH_SAK_CACHE, r9
    ldi:20  #1024, r10
    ldi:8   #8, r13
    ldi:8   #16, r3
sak_clr_lp:
    st      r2, @r9 ; st r2, @(r13, r9) ; add r3, r9
    st      r2, @r9 ; st r2, @(r13, r9) ; add r3, r9
    add2    #-1, r10 ; cmp #0, r10 ; bgt sak_clr_lp
    st      r1, @r8
    ldi:8   #4, r13 ; st r0, @(r13, r8)
rp_call:
    mov     r14, r4 ; ldi:8 #144, r0 ; sub r0, r4
    ldi:32  #VA_YCC_SUB, r12 ; call @r12
    jmp.far done_exit

// 2-row SWAR horizontal preload & step (max sum*51 = 1275*51 = 65025 < 65536 -> 0 carry across 16-bit lanes)
.macro b5_h2_load dst
    ldub    @r5, \dst ; lsl2 #16, \dst ; ldub @(r13, r5), r0 ; or r0, \dst ; add #1, r5
.endm

.macro b5_h2_step ring
    ldub    @r5, r0 ; lsl2 #16, r0
    ldub    @(r13, r5), r1 ; or r1, r0 ; add #1, r5
    add     r0, r2
    mov     r2, r1 ; mul r3, r1 ; mov MDL, r1
    mov     r1, r10 ; lsr2 #24, r10 ; stb r10, @r12
    lsr     #8, r1 ; stb r1, @(r13, r12) ; add #1, r12
    sub     \ring, r2 ; mov r0, \ring
.endm

// 2-column SWAR vertical preload & step (lduh/sth on 2-byte aligned even-width grids)
.macro b5_v2_load dst
    lduh    @r5, \dst ; add r10, r5
    mov     \dst, r1 ; lsr #8, r1 ; lsl2 #16, r1
    extub   \dst ; or r1, \dst
.endm

.macro b5_v2_step ring
    lduh    @r5, r0 ; add r10, r5
    mov     r0, r1 ; lsr #8, r1 ; lsl2 #16, r1
    extub   r0 ; or r1, r0
    add     r0, r2
    mov     r2, r1 ; mul r3, r1 ; mov MDL, r1
    mov     r1, r13 ; lsr2 #24, r13 ; lsl #8, r13
    lsr     #8, r1 ; extub r1 ; or r13, r1
    sth     r1, @r12 ; add r10, r12
    sub     \ring, r2 ; mov r0, \ring
.endm

// in-place 5-tap separable box blur: r0 = grid VA, r11 = passes; @(r14,#-40)=gw, @(r14,#-44)=gh
blur_5tap_sub:
    st      r0, @(r14, #-52)
    st      r11, @(r14, #-56)
    ldi:8   #51, r3
b5_pass:
    ld      @(r14, #-52), r8
    ld      @(r14, #-44), r6
    ld      @(r14, #-40), r7
    ldi:8   #5, r0 ; cmp r0, r7 ; blt.far b5_v_start
    cmp     #2, r6 ; blt.far b5_h_row
    st      r8, @(r14, #-148)
    st      r6, @(r14, #-152)
    mov     r7, r13
b5_h2_lp:
    ld      @(r14, #-148), r5
    b5_h2_load r4 ; mov r4, r2
    b5_h2_load r6 ; add r6, r2
    mov     r5, r12
    b5_h2_load r8 ; add r8, r2
    b5_h2_load r9 ; add r9, r2
    mov     r13, r7 ; add2 #-4, r7
b5_h2_x4:
    cmp     #4, r7 ; blt b5_h2_t0
    b5_h2_step r4
    b5_h2_step r6
    b5_h2_step r8
    b5_h2_step r9
    add2    #-4, r7 ; bra b5_h2_x4
b5_h2_t0:
    cmp     #0, r7 ; ble b5_h2_edge
    b5_h2_step r4
    mov     r6, r4 ; mov r8, r6 ; mov r9, r8
    add2    #-1, r7 ; bra b5_h2_t0
b5_h2_edge:
    stb     r10, @r12 ; stb r1, @(r13, r12) ; add #1, r12
    stb     r10, @r12 ; stb r1, @(r13, r12)
    ld      @(r14, #-148), r8
    mov     r8, r5 ; add #2, r5
    ldub    @r5, r0 ; stb r0, @r8
    ldub    @(r13, r5), r1 ; stb r1, @(r13, r8)
    add     #1, r8 ; stb r0, @r8 ; stb r1, @(r13, r8) ; add2 #-1, r8
    add     r13, r8 ; add r13, r8 ; st r8, @(r14, #-148)
    ld      @(r14, #-152), r6 ; add2 #-2, r6 ; st r6, @(r14, #-152)
    cmp     #2, r6 ; bge.far b5_h2_lp
    mov     r13, r7
    cmp     #0, r6 ; ble b5_v_start

b5_h_row:
    mov     r8, r5
    ldub    @r5, r4 ; mov r4, r2 ; add #1, r5
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add #1, r5
    mov     r5, r12
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add #1, r5
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add #1, r5
    mov     r7, r10 ; add2 #-4, r10
b5_h_x:
    ldub    @r5, r0 ; add #1, r5
    add     r0, r2
    mov     r2, r1 ; mul r3, r1 ; mov MDL, r1 ; lsr #8, r1
    stb     r1, @r12 ; add #1, r12
    mov     r4, r13 ; lsr2 #24, r13 ; sub r13, r2
    lsl     #8, r4 ; or r0, r4
    add2    #-1, r10 ; cmp #0, r10 ; bgt b5_h_x
    stb     r1, @r12 ; add #1, r12 ; stb r1, @r12
    ldi:8   #2, r13 ; ldub @(r13, r8), r0
    stb     r0, @r8 ; ldi:8 #1, r13 ; stb r0, @(r13, r8)
    add     r7, r8 ; add2 #-1, r6 ; cmp #0, r6 ; bgt b5_h_row

b5_v_start:
    ld      @(r14, #-44), r9
    ldi:8   #5, r0 ; cmp r0, r9 ; blt.far b5_pass_next
    ld      @(r14, #-52), r8
    ld      @(r14, #-40), r6
    mov     r6, r10
    ldi:8   #1, r0 ; and r10, r0 ; bne.far b5_v_col
    st      r8, @(r14, #-148)
    st      r6, @(r14, #-152)
b5_v2_lp:
    ld      @(r14, #-148), r5
    b5_v2_load r4 ; mov r4, r2
    b5_v2_load r6 ; add r6, r2
    mov     r5, r12
    b5_v2_load r8 ; add r8, r2
    b5_v2_load r9 ; add r9, r2
    ld      @(r14, #-44), r7 ; add2 #-4, r7
b5_v2_y4:
    cmp     #4, r7 ; blt b5_v2_t0
    b5_v2_step r4
    b5_v2_step r6
    b5_v2_step r8
    b5_v2_step r9
    add2    #-4, r7 ; bra b5_v2_y4
b5_v2_t0:
    cmp     #0, r7 ; ble b5_v2_edge
    b5_v2_step r4
    mov     r6, r4 ; mov r8, r6 ; mov r9, r8
    add2    #-1, r7 ; bra b5_v2_t0
b5_v2_edge:
    sth     r1, @r12 ; add r10, r12 ; sth r1, @r12
    ld      @(r14, #-148), r8
    mov     r8, r5 ; add r10, r5 ; mov r5, r12 ; add r10, r12
    lduh    @r12, r0 ; sth r0, @r8 ; sth r0, @r5
    add     #2, r8 ; st r8, @(r14, #-148)
    ld      @(r14, #-152), r6 ; add2 #-2, r6 ; st r6, @(r14, #-152)
    cmp     #2, r6 ; bge.far b5_v2_lp
    bra     b5_pass_next

b5_v_col:
    mov     r8, r5
    ldub    @r5, r4 ; mov r4, r2 ; add r10, r5
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add r10, r5
    mov     r5, r12
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add r10, r5
    ldub    @r5, r0 ; add r0, r2 ; lsl #8, r4 ; or r0, r4 ; add r10, r5
    mov     r9, r7 ; add2 #-4, r7
b5_v_y:
    ldub    @r5, r0 ; add r10, r5
    add     r0, r2
    mov     r2, r1 ; mul r3, r1 ; mov MDL, r1 ; lsr #8, r1
    stb     r1, @r12 ; add r10, r12
    mov     r4, r13 ; lsr2 #24, r13 ; sub r13, r2
    lsl     #8, r4 ; or r0, r4
    add2    #-1, r7 ; cmp #0, r7 ; bgt b5_v_y
    stb     r1, @r12 ; add r10, r12 ; stb r1, @r12
    mov     r8, r5 ; add r10, r5 ; mov r5, r12 ; add r10, r12
    ldub    @r12, r0 ; stb r0, @r8 ; stb r0, @r5
    add     #1, r8 ; add2 #-1, r6 ; cmp #0, r6 ; bgt b5_v_col

b5_pass_next:
    ld      @(r14, #-56), r11 ; add2 #-1, r11 ; st r11, @(r14, #-56)
    cmp     #0, r11 ; bgt.far b5_pass
    ret
