// matrix hook @ 0x4D3782: 1..8/191..198 stock, 14..18 mono q7, else q10 CMCM @ q7 CCMatrix

.include "m5_addrs.inc"

    ld      @(r14, #12), r0
    cmp     #9, r0
    blt     stock
    ldi:8   #190, r1
    cmp     r1, r0
    bgt     stock

    st      r6, @-r15
    st      r7, @-r15
    st      r8, @-r15
    st      r9, @-r15
    st      r10, @-r15
    st      r11, @-r15
    st      RP, @-r15

    cmp     #14, r0
    blt     do_leftmul
    ldi:8   #18, r1
    cmp     r1, r0
    bgt     do_leftmul

    add2    #-14, r0
    ldi:8   #20, r1
    mul     r1, r0
    mov     MDL, r0
    ldi:32  #VA_MONO_TABLE, r4
    add     r0, r4
    ldi:32  #SYM_COMMIT_CCMAT, r12
    call    @r12
    bra     epilogue

do_leftmul:
    add2    #-9, r0
    lsl     #5, r0
    ldi:32  #VA_CMCM_TABLE, r8
    add     r0, r8
    ldi:32  #SYM_CC_MATRIX_Q7, r9

    addsp   #-24
    mov     r15, r10
    ldi:20  #0x00200, r5
    sth     r5, @r10
    mov     r10, r4
    add     #2, r4
    ldi:20  #0x007FF, r6
    ldi:32  #0xFFFFF801, r7
    ldi:8   #3, r1

loop_i:
    mov     r9, r12
    ldi:8   #3, r0
loop_j:
    lduh    @r8, r2 ; extsh r2
    lduh    @r12, r3 ; lsl2 #20, r3 ; asr2 #20, r3
    mul     r2, r3 ; mov MDL, r11

    ldi:8   #2, r13 ; lduh @(r13, r8), r2 ; extsh r2
    ldi:8   #6, r13 ; lduh @(r13, r12), r3 ; lsl2 #20, r3 ; asr2 #20, r3
    mul     r2, r3 ; mov MDL, r2 ; add r2, r11

    ldi:8   #4, r13 ; lduh @(r13, r8), r2 ; extsh r2
    ldi:8   #12, r13 ; lduh @(r13, r12), r3 ; lsl2 #20, r3 ; asr2 #20, r3
    mul     r2, r3 ; mov MDL, r2 ; add r2, r11

    add     r5, r11
    asr     #10, r11

    cmp     r6, r11 ; ble hi_ok ; mov r6, r11
hi_ok:
    cmp     r7, r11 ; bge lo_ok ; mov r7, r11
lo_ok:
    ldi:20  #0x00FFF, r2 ; and r2, r11
    sth     r11, @r4
    add     #2, r4
    add     #2, r12
    add2    #-1, r0 ; cmp #0, r0 ; bgt loop_j

    add     #6, r8
    add2    #-1, r1 ; cmp #0, r1 ; bgt loop_i

    mov     r10, r4
    ldi:32  #SYM_COMMIT_CCMAT, r12
    call    @r12
    addsp   #24

epilogue:
    ld      @r15+, RP
    ld      @r15+, r11
    ld      @r15+, r10
    ld      @r15+, r9
    ld      @r15+, r8
    ld      @r15+, r7
    ld      @r15+, r6
    ret

stock:
    ldi:32  #SYM_STOCK_MATRIX, r12
    jmp     @r12
